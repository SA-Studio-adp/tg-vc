# Bot token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# From https://my.telegram.org -> API Development Tools
API_ID=123456
API_HASH=your_api_hash_here

# Generated by running generate_session.py locally (see README)
SESSION_STRING=paste_the_long_string_here

# The GROUP (not channel) whose voice chat gets streamed into.
# The userbot account behind SESSION_STRING must already be a member.
# Get this by forwarding a message from the group to @userinfobot,
# or from the group's t.me link if it's public.
CHAT_ID=-1001234567890

# Comma-separated Telegram user IDs allowed to run bot commands
ADMIN_IDS=111111111,222222222

DOWNLOAD_DIR=downloads

# --- Web dashboard ---
# Render sets PORT automatically — you usually don't need to set this yourself.
PORT=10000
# Pick your own secret string. Without this, ANYONE with your dashboard URL
# can pause/skip/end the voice chat — always set it in production.
DASHBOARD_TOKEN=change_me_to_something_random
