# Bot token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# From https://my.telegram.org -> API Development Tools
API_ID=123456
API_HASH=your_api_hash_here

# Generated by running generate_session.py locally (see README)
SESSION_STRING=paste_the_long_string_here

# The GROUP (not channel) whose voice chat gets streamed into.
# The userbot account behind SESSION_STRING must already be a member.
# Get this by forwarding a message from the group to @userinfobot,
# or from the group's t.me link if it's public.
CHAT_ID=-1001234567890

# Comma-separated Telegram user IDs allowed to run bot commands
ADMIN_IDS=111111111,222222222

DOWNLOAD_DIR=downloads

# --- Web dashboard ---
# Render sets PORT automatically — you usually don't need to set this yourself.
PORT=10000
# Pick your own secret string. Without this, ANYONE with your dashboard URL
# can pause/skip/end the voice chat — always set it in production.
DASHBOARD_TOKEN=change_me_to_something_random

# --- YouTube cookies (fixes "Sign in to confirm you're not a bot") ---
# Path to a cookies.txt exported from a logged-in browser session.
# On Render, upload via Secret Files and point this at the mounted path.
# See README for full instructions. Leave blank to skip (may cause
# download failures on cloud hosts).
COOKIES_FILE=

# --- YouTube PO token server (fixes it further, alongside cookies) ---
# The Docker image already runs a local PO-token server and sets this
# automatically to http://127.0.0.1:4416 — you don't need to set this
# yourself when deploying via the provided Dockerfile. Only set it if
# you're running the token server elsewhere (e.g. a separate host/service).
POT_PROVIDER_BASE_URL=
